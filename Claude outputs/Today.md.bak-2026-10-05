## Today's top 3

```dataviewjs
const today = dv.date("today");
const iso = today.toFormat("yyyy-MM-dd");

// Most recent daily note dated before today carries today's top 3.
const prior = dv.pages('"Logbook/Daily"')
  .where(p => /^\d{4}-\d{2}-\d{2}/.test(p.file.name) && p.file.name.slice(0, 10) < iso)
  .sort(p => p.file.name, "desc");

const section = (text, heading) => {
  const re = new RegExp(`\\*\\*${heading}\\*\\*[ \\t]*\\n([\\s\\S]*?)(?=\\n\\*\\*[^*\\n]+\\*\\*[ \\t]*\\n|$)`);
  const m = text.match(re);
  return m ? m[1] : "";
};

if (!prior.length) {
  dv.paragraph("*No earlier daily note found.*");
} else {
  const src = prior[0];
  const text = await dv.io.load(src.file.path);
  const top = section(text, "Tomorrow[’']s top 3")
    .split("\n")
    .map(l => l.match(/^\s*\d+\.\s+(.+)$/))
    .filter(Boolean)
    .map(m => m[1].trim());
  const inbox = section(text, "Inbox")
    .split("\n")
    .map(l => l.match(/^\s*-\s+(.+)$/))
    .filter(Boolean)
    .map(m => m[1].trim());

  if (top.length) {
    dv.paragraph(top.map((t, i) => `${i + 1}. ${t}`).join("\n"));
  } else {
    dv.paragraph(`*${src.file.name} has no "Tomorrow's top 3".*`);
  }
  dv.paragraph(`<small>From [[${src.file.path}|${src.file.name}]]</small>`);

  if (inbox.length) {
    const body = inbox.map(t => `> - ${t}`).join("\n");
    dv.paragraph(`> [!inbox]- Carried Inbox (${inbox.length})\n${body}`);
  }
}
