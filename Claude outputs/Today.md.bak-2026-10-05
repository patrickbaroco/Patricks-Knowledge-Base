## Next by project

```dataviewjs
// Live from the project notes' frontmatter: one line per active project, its next_action,
// and gated projects shown with their gate date. Replaced "Open from the Handoff" 2026-09-24,
// because the Handoff is a weekly snapshot and went stale midweek.
const compact = (s) => {
  s = String(s ?? "").trim();
  const abbrev = /(?:\b(?:Dr|Mr|Mrs|Ms|St|vs|No|e\.g|i\.e|approx))$/;
  const re = /[.!?](\*{0,2})(?=\s|$)/g;
  let m, cut = s.length;
  while ((m = re.exec(s)) !== null) {
    if (m.index < 25 || abbrev.test(s.slice(0, m.index))) continue;
    cut = m.index + 1 + m[1].length;
    break;
  }
  if (cut > 200) cut = s.lastIndexOf(" ", 200);
  let out = s.slice(0, cut).replace(/[\s,;:—·]+$/, "");
  if (((out.match(/\*\*/g) || []).length) % 2) out += "**";
  if (((out.match(/`/g) || []).length) % 2) out += "`";
  return out + (cut < s.length ? " …" : "");
};
const todayD = dv.date("today");
const projects = dv.pages('"Projects"')
  .where(p => p.status === "active" && !p.file.name.startsWith("_") && p.cadence !== "untracked");
const now = [], gated = [];
for (const p of projects) {
  const gate = p.gated_until ? dv.date(p.gated_until) : null;
  if (gate && gate.valueOf() >= todayD.valueOf()) {
    gated.push({ p, gate });
  } else {
    now.push(p);
  }
}
if (now.length) {
  dv.paragraph(now.sort(p => p.file.name)
    .map(p => `- ${p.file.link} — ${compact(p.next_action) || "*no next action*"}`).join("\n"));
} else {
  dv.paragraph("*No active project is ungated.*");
}
if (gated.length) {
  gated.sort((a, b) => a.gate.valueOf() - b.gate.valueOf());
  dv.paragraph(gated.map(({ p, gate }) =>
    `- 🚦 ${p.file.link} · until ${gate.toFormat("ccc MMM d")}${p.gate ? " — " + compact(p.gate) : ""}`).join("\n"));
}
```

## Project pulse

```dataviewjs
const nowMs = dv.date("now").valueOf();
const active = dv.pages('"Projects"')
  .where(p => p.status === "active" && !p.file.name.startsWith("_"));
const waiting = dv.pages('"Projects"')
  .where(p => (p.status === "waiting" || p.status === "blocked") && !p.file.name.startsWith("_"));

const rows = [];
let green = 0, untracked = 0;
const gated = [];
const todayD = dv.date("today");
for (const p of active) {
  if (p.cadence === "untracked") { untracked++; continue; }
  // gated_until: nothing to do before this date, so no flag. After it, the quiet clock starts at the gate date.
  const gate = p.gated_until ? dv.date(p.gated_until) : null;
  if (gate && gate.valueOf() >= todayD.valueOf()) {
    gated.push(`${p.file.link} until ${gate.toFormat("MMM d")}${p.gate ? " · " + p.gate : ""}`);
    continue;
  }
  let mt = [p.file.mtime];
  if (gate) mt.push(gate);
  if (p.related) {
    for (const r of (Array.isArray(p.related) ? p.related : [p.related])) {
      const name = (r && r.path) ? r.path : String(r).replace(/\[\[|\]\]/g, "").split("|")[0];
      const rp = dv.page(name);
      if (rp && rp.file) mt.push(rp.file.mtime);
    }
  }
  const last = mt.reduce((a, b) => (a.valueOf() > b.valueOf() ? a : b));
  const days = Math.floor((nowMs - last.valueOf()) / 86400000);
  if (days >= 7) rows.push(["🔴", p.file.link, days, p.next_action ?? ""]);
  else if (days >= 4) rows.push(["🟡", p.file.link, days, p.next_action ?? ""]);
  else green++;
}

dv.paragraph(`🟢 ${green} moving · 🟡/🔴 ${rows.length} quiet · 🚦 ${gated.length} gated · ⏳ ${waiting.length} waiting · ⏸️ ${untracked} untracked`);
if (gated.length) dv.paragraph(`<small>🚦 ${gated.join(" · ")}</small>`);
if (rows.length) {
  rows.sort((a, b) => b[2] - a[2]);
  dv.table(["", "Project", "Days quiet", "Next action"], rows);
}
dv.paragraph("<small>File activity only. Home MOC's per-project exceptions (e.g. Insulin reviewed weekly with no task) still apply; the full check is in [[Projects/_Projects Dashboard|Projects Dashboard]].</small>");
```

