```dataviewjs
// Fishing. South River first, Mossy Creek folded in.
// Fishing/South River Forecast.md is rewritten each morning (~5:50am) by a scheduled Claude task from the NOAA gauges
// (WAYV2 primary), AccuWeather Waynesboro and the current Mossy Creek note. It is the South River that runs
// Greenville -> Waynesboro -> Port Republic, never the Vesuvius/Maury South River.
// Fishing/Forecasts/<Monday>.md is written Monday evening (Tuesday 6am retry) from the Mossy Creek weekly post.
// Day sections there are "## Monday" ... "## Sunday", plus "## Weekend".
const today = dv.date("today");
const iso = today.toFormat("yyyy-MM-dd");
const monday = today.minus({ days: today.weekday - 1 }).toFormat("yyyy-MM-dd");
const dayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const tomorrow = today.plus({ days: 1 });
const sat = today.plus({ days: 6 - today.weekday }).toFormat("LLL d");
const sun = today.plus({ days: 7 - today.weekday }).toFormat("LLL d");
// On Saturday and Sunday, Today/Tomorrow already cover this weekend, so the South River note's Weekend is next weekend.
const nOff = today.weekday >= 6 ? 7 : 0;
const nSat = today.plus({ days: 6 - today.weekday + nOff }).toFormat("LLL d");
const nSun = today.plus({ days: 7 - today.weekday + nOff }).toFormat("LLL d");

const section = (text, heading) => {
  const re = new RegExp(`^## ${heading}[ \\t]*\\n([\\s\\S]*?)(?=^## |(?![\\s\\S]))`, "m");
  const m = text.match(re);
  return m ? m[1].trim() : "";
};
// A kind ending in "-" renders as a folded callout, e.g. "quote-" -> "> [!quote]- Title".
const callout = (kind, title, body, empty = "*Not covered.*") =>
  `> [!${kind.replace(/-$/, "")}]${kind.endsWith("-") ? "-" : ""} ${title}\n` + (body || empty).split("\n").map(l => `> ${l}`).join("\n");

// Mossy Creek weekly note
const notes = dv.pages('"Fishing/Forecasts"')
  .where(p => p.type === "fishing-forecast" && /^\d{4}-\d{2}-\d{2}$/.test(p.file.name) && p.file.name <= iso)
  .sort(p => p.file.name, "desc");
const mc = notes.length && notes[0].file.name === monday ? notes[0] : null;
const mcText = mc ? await dv.io.load(mc.file.path) : "";

// South River daily note
const sr = dv.page("Fishing/South River Forecast");
const srDate = sr && sr.forecast_date ? dv.date(sr.forecast_date).toFormat("yyyy-MM-dd") : null;
const srText = sr ? (await dv.io.load(sr.file.path)).replace(/^---\n[\s\S]*?\n---\n/, "") : "";

const flow = sr && srDate === iso && sr.flow_cfs != null ? ` · ${sr.flow_cfs} cfs at Waynesboro` : "";
dv.paragraph(`**Fishing, South River**${flow}`);

const out = [];
if (sr && srDate === iso) {
  out.push(callout("abstract", "Now", section(srText, "Now")));
  out.push(callout("info", `Today · ${today.toFormat("ccc LLL d")}`, section(srText, "Today")));
  out.push(callout("note", `Tomorrow · ${tomorrow.toFormat("ccc LLL d")}`, section(srText, "Tomorrow")));
  out.push(callout("tip", `${nOff ? "Next weekend" : "Weekend"} · ${nSat} to ${nSun}`, section(srText, "Weekend")));
  if (mc) {
    out.push(callout("quote-", `Mossy Creek · spring creeks and region, ${today.toFormat("cccc")}`,
      section(mcText, dayNames[today.weekday - 1]), "*Not covered in this week's post.*"));
  }
} else {
  out.push(callout("warning", sr ? `South River forecast is from ${srDate ?? "an unknown date"}` : "No South River forecast yet",
    "The 5:50am run didn't land (Mac asleep or the Claude app closed). Ask Command Center to *refresh the South River forecast*. Mossy Creek's day-by-day is below."));
  if (mc) {
    out.push(callout("info", `Mossy Creek · Today · ${today.toFormat("ccc LLL d")}`, section(mcText, dayNames[today.weekday - 1]), "*Not covered in this week's post.*"));
    out.push(callout("note", `Mossy Creek · Tomorrow · ${tomorrow.toFormat("ccc LLL d")}`,
      today.weekday === 7 ? "Next week's forecast posts Monday." : section(mcText, dayNames[tomorrow.weekday - 1]), "*Not covered in this week's post.*"));
    out.push(callout("tip", `Mossy Creek · Weekend · ${sat} to ${sun}`, section(mcText, "Weekend"), "*Not covered in this week's post.*"));
  }
}
if (!mc) {
  const last = notes.length ? notes[0] : null;
  out.push(callout("warning", "This week's Mossy Creek forecast isn't in yet",
    `Mossy Creek usually posts Monday; the scheduled task checks Monday evening and again Tuesday at 6am.` +
    (last ? `\nLast forecast: [[${last.file.path}|week of ${last.file.name}]].` : "")));
}
dv.paragraph(out.join("\n\n"));

const links = [];
if (sr) links.push(`[[Fishing/South River Forecast|South River note]]`);
links.push(`[Gauge](https://water.noaa.gov/gauges/WAYV2)`);
if (mc) links.push(`[[${mc.file.path}|Mossy Creek forecast]]`);
if (mc && mc.source) links.push(`[Blog post](${mc.source})`);
if (mc && mc.video) links.push(`[Video](${mc.video})`);
dv.paragraph(`<small>${links.join(" · ")}</small>`);
```

