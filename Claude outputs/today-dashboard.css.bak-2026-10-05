/* Today.md dashboard — Eventus purple accents */
.today-dash { --today-accent: #877AE9; --today-heading: #7368C6; }
.today-dash.markdown-preview-view h1 { color: var(--today-heading); margin-bottom: 0.3em; }
.today-dash.markdown-preview-view h2 {
  color: var(--today-heading);
  font-size: 0.95em;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-bottom: 1px solid var(--today-accent);
  padding-bottom: 0.2em;
  margin-top: 1.8em;
}
.today-dash .inline-title { display: none; }
.today-dash .today-links { display: flex; flex-wrap: wrap; gap: 0.4em; margin: 0.4em 0 1em; }
.today-dash .today-links button {
  border: 1px solid var(--today-accent);
  background: transparent;
  color: var(--text-normal);
  border-radius: 6px;
  padding: 0.25em 0.7em;
  font-size: 0.85em;
  cursor: pointer;
}
.today-dash .today-links button:hover { background: var(--today-accent); color: white; }
.today-dash .internal-embed.markdown-embed { border-left: 3px solid var(--today-accent); padding-left: 0.8em; }
.today-dash .callout[data-callout="inbox"] { --callout-color: 135, 122, 233; --callout-icon: lucide-inbox; }
.today-dash .today-brief { border-left: 3px solid var(--today-accent); padding-left: 0.8em; }
